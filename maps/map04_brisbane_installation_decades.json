{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Brisbane public artworks by installation period.",
  "width": 720,
  "height": 540,
  "projection": {"type": "mercator", "center": [153.025, -27.47], "scale": 105000},
  "layer": [
    {"data": {"url": "../Data/brisbane-suburbs.geojson", "format": {"type": "json", "property": "features"}}, "mark": {"type": "geoshape", "fill": "#ece7df", "stroke": "#a89f93", "strokeWidth": 0.7}},
    {"data": {"url": "../Data/public-art-brisbane-clean.csv"}, "transform": [
      {"filter": "isValid(datum.Longitude) && isValid(datum.Latitude) && isFinite(toNumber(datum.Installed))"},
      {"calculate": "toNumber(datum.Installed) < 1980 ? 'Before 1980' : toNumber(datum.Installed) < 1990 ? '1980s' : toNumber(datum.Installed) < 2000 ? '1990s' : toNumber(datum.Installed) < 2010 ? '2000s' : toNumber(datum.Installed) < 2020 ? '2010s' : '2020s'", "as": "installation_period"}
    ], "mark": {"type": "circle", "size": 58, "opacity": 0.85, "stroke": "#ffffff", "strokeWidth": 0.5}, "encoding": {
      "longitude": {"field": "Longitude", "type": "quantitative"}, "latitude": {"field": "Latitude", "type": "quantitative"},
      "color": {"field": "installation_period", "type": "nominal", "title": "Installed", "scale": {"domain": ["Before 1980", "1980s", "1990s", "2000s", "2010s", "2020s"], "range": ["#5B3A29", "#8B5A2B", "#C28C3C", "#7A9E9F", "#4F7CAC", "#6C5B9C"]}, "legend": {"orient": "right", "symbolSize": 90}},
      "tooltip": [{"field": "Title", "type": "nominal", "title": "Artwork"},{"field": "Artist", "type": "nominal", "title": "Artist"},{"field": "Suburb", "type": "nominal", "title": "Suburb"},{"field": "Installed", "type": "nominal", "title": "Installed"},{"field": "Main Material", "type": "nominal", "title": "Material"}]
    }}
  ],
  "config": {"background": "#fffdf9", "view": {"stroke": null}, "legend": {"labelFont": "Arial", "labelFontSize": 11, "titleFont": "Arial", "titleFontSize": 12}}
}
