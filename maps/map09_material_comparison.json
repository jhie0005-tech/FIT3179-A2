{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Brisbane and Canberra public art coloured by grouped material. Melbourne is excluded because its source has no material field.",
  "data": {
    "url": "Data/processed/public_art_material_groups.csv",
    "format": {
      "type": "csv",
      "parse": {
        "longitude": "number",
        "latitude": "number"
      }
    }
  },
  "hconcat": [
    {
      "title": {
        "text": "Brisbane",
        "subtitle": "198 works \u00b7 map window about 26 \u00d7 34 km",
        "anchor": "start",
        "subtitleColor": "#666"
      },
      "width": 260,
      "height": 340,
      "projection": {
        "type": "mercator",
        "center": [
          153.0577,
          -27.4547
        ],
        "scale": 56500,
        "translate": [
          130.0,
          170.0
        ]
      },
      "layer": [
        {
          "data": {
            "url": "Data/brisbane-suburbs.geojson",
            "format": {
              "type": "json",
              "property": "features"
            }
          },
          "mark": {
            "type": "geoshape",
            "fill": "#fbfaf6",
            "stroke": "#d6d0c2",
            "strokeWidth": 0.6
          }
        },
        {
          "transform": [
            {
              "filter": "datum.city === 'Brisbane'"
            },
            {
              "calculate": "datum.material_group === 'Not recorded' ? 0 : 1",
              "as": "draw_order"
            },
            {
              "calculate": "datum.material ? datum.material : 'Not recorded'",
              "as": "mat"
            }
          ],
          "mark": {
            "type": "circle",
            "size": 22,
            "opacity": 0.85,
            "stroke": "#ffffff",
            "strokeWidth": 0.3
          },
          "encoding": {
            "longitude": {
              "field": "longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "latitude",
              "type": "quantitative"
            },
            "order": {
              "field": "draw_order",
              "type": "quantitative"
            },
            "color": {
              "field": "material_group",
              "type": "nominal",
              "title": "Material group",
              "scale": {
                "domain": [
                  "Metal",
                  "Stone / concrete / brick",
                  "Timber",
                  "Paint",
                  "Tile / ceramic",
                  "Mixed materials",
                  "Other materials",
                  "Not recorded"
                ],
                "range": [
                  "#0072B2",
                  "#8C8C8C",
                  "#A65628",
                  "#D55E00",
                  "#56B4E9",
                  "#CC79A7",
                  "#E69F00",
                  "#D3D3D3"
                ]
              },
              "legend": {
                "orient": "bottom",
                "columns": 4,
                "symbolType": "circle",
                "labelLimit": 220,
                "titleAnchor": "start"
              }
            },
            "tooltip": [
              {
                "field": "material_group",
                "type": "nominal",
                "title": "Material group"
              },
              {
                "field": "mat",
                "type": "nominal",
                "title": "Original material"
              }
            ]
          }
        },
        {
          "data": {
            "values": [
              {
                "lon1": 152.9362,
                "lon2": 152.9868,
                "lat": -27.5968
              }
            ]
          },
          "mark": {
            "type": "rule",
            "color": "#333",
            "strokeWidth": 2
          },
          "encoding": {
            "longitude": {
              "field": "lon1",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "longitude2": {
              "field": "lon2"
            },
            "latitude2": {
              "field": "lat"
            }
          }
        },
        {
          "data": {
            "values": [
              {
                "lon": 152.9615,
                "lat": -27.5968,
                "label": "5 km"
              }
            ]
          },
          "mark": {
            "type": "text",
            "dy": -7,
            "fontSize": 11,
            "color": "#333",
            "stroke": "#f4f1ea",
            "strokeWidth": 3,
            "strokeJoin": "round"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "label"
            }
          }
        }
      ]
    },
    {
      "title": {
        "text": "Canberra",
        "subtitle": "562 works \u00b7 map window about 41 \u00d7 53 km",
        "anchor": "start",
        "subtitleColor": "#666"
      },
      "width": 260,
      "height": 340,
      "projection": {
        "type": "mercator",
        "center": [
          149.0356,
          -35.3652
        ],
        "scale": 33250,
        "translate": [
          130.0,
          170.0
        ]
      },
      "layer": [
        {
        "data": {
        "url": "../Data/processed/Canberra roads.geojson",
        "format": {"type": "json", "property": "features"}
        },
        "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#b8aea0",
        "strokeWidth": 0.3
        }
            },
        {
          "transform": [
            {
              "filter": "datum.city === 'Canberra'"
            },
            {
              "calculate": "datum.material_group === 'Not recorded' ? 0 : 1",
              "as": "draw_order"
            },
            {
              "calculate": "datum.material ? datum.material : 'Not recorded'",
              "as": "mat"
            }
          ],
          "mark": {
            "type": "circle",
            "size": 22,
            "opacity": 0.85,
            "stroke": "#ffffff",
            "strokeWidth": 0.3
          },
          "encoding": {
            "longitude": {
              "field": "longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "latitude",
              "type": "quantitative"
            },
            "order": {
              "field": "draw_order",
              "type": "quantitative"
            },
            "color": {
              "field": "material_group",
              "type": "nominal",
              "title": "Material group",
              "scale": {
                "domain": [
                  "Metal",
                  "Stone / concrete / brick",
                  "Timber",
                  "Paint",
                  "Tile / ceramic",
                  "Mixed materials",
                  "Other materials",
                  "Not recorded"
                ],
                "range": [
                  "#0072B2",
                  "#8C8C8C",
                  "#A65628",
                  "#D55E00",
                  "#56B4E9",
                  "#CC79A7",
                  "#E69F00",
                  "#D3D3D3"
                ]
              },
              "legend": {
                "orient": "bottom",
                "columns": 4,
                "symbolType": "circle",
                "labelLimit": 220,
                "titleAnchor": "start"
              }
            },
            "tooltip": [
              {
                "field": "material_group",
                "type": "nominal",
                "title": "Material group"
              },
              {
                "field": "mat",
                "type": "nominal",
                "title": "Original material"
              }
            ]
          }
        },
        {
          "data": {
            "values": [
              {
                "lon1": 148.8292,
                "lon2": 148.8843,
                "lat": -35.5872
              }
            ]
          },
          "mark": {
            "type": "rule",
            "color": "#333",
            "strokeWidth": 2
          },
          "encoding": {
            "longitude": {
              "field": "lon1",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "longitude2": {
              "field": "lon2"
            },
            "latitude2": {
              "field": "lat"
            }
          }
        },
        {
          "data": {
            "values": [
              {
                "lon": 148.8567,
                "lat": -35.5872,
                "label": "5 km"
              }
            ]
          },
          "mark": {
            "type": "text",
            "dy": -7,
            "fontSize": 11,
            "color": "#333",
            "stroke": "#f4f1ea",
            "strokeWidth": 3,
            "strokeJoin": "round"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "label"
            }
          }
        }
      ]
    }
  ],
  "resolve": {
    "scale": {
      "color": "shared"
    },
    "legend": {
      "color": "shared"
    }
  },
  "spacing": 24,
  "config": {
    "view": {
      "stroke": "#d8d2c4",
      "fill": "#f4f1ea"
    },
    "title": {
      "fontSize": 15,
      "subtitleFontSize": 11
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12
    }
  }
}
