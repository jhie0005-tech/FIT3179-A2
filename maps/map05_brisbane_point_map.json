{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Brisbane City Council public artworks, with records at identical coordinates combined into proportional circles.",
  "width": 720,
  "height": 540,
  "projection": {
    "type": "mercator",
    "center": [153.025, -27.47],
    "scale": 105000 },
  "layer": [
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/world-atlas@2/countries-50m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      
      "transform": [
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#ece7df",
        "stroke": "#a89f93",
        "strokeWidth": 0.7
      }
    },
    {
    "data": {
      "url": "../Data/brisbane-suburbs.geojson",
      "format": {"type": "json", "property": "features"}
    },
    "mark": {
      "type": "geoshape",
      "fill": "#ece7df",
      "stroke": "#a89f93",
      "strokeWidth": 0.7
    }
    },
    {
      "params": [
        {
          "name": "materialSelection",
          "select": {
            "type": "point",
            "fields": ["material_group"]
          },
          "bind": "legend"
        }
      ],
      "data": {
        "url": "../Data/public-art-brisbane-clean.csv"
      },
      "transform": [
        {
          "filter": "isValid(datum.Longitude) && isValid(datum.Latitude)"
        },
        {
          "calculate": "indexof(lower(datum['Main Material'] || ''), 'sandstone') >= 0 || indexof(lower(datum['Main Material'] || ''), 'granite') >= 0 || indexof(lower(datum['Main Material'] || ''), 'marble') >= 0 || indexof(lower(datum['Main Material'] || ''), 'stone') >= 0 || indexof(lower(datum['Main Material'] || ''), 'concrete') >= 0 || indexof(lower(datum['Main Material'] || ''), 'cement') >= 0 ? 'Stone / concrete / brick' : indexof(lower(datum['Main Material'] || ''), 'steel') >= 0 || indexof(lower(datum['Main Material'] || ''), 'metal') >= 0 || indexof(lower(datum['Main Material'] || ''), 'aluminium') >= 0 || indexof(lower(datum['Main Material'] || ''), 'aluminum') >= 0 || indexof(lower(datum['Main Material'] || ''), 'copper') >= 0 || indexof(lower(datum['Main Material'] || ''), 'brass') >= 0 ? 'Metal' : indexof(lower(datum['Main Material'] || ''), 'wood') >= 0 || indexof(lower(datum['Main Material'] || ''), 'timber') >= 0 ? 'Timber' : indexof(lower(datum['Main Material'] || ''), 'ceramic') >= 0 ? 'Tile / ceramic' : indexof(lower(datum['Main Material'] || ''), 'paint') >= 0 || indexof(lower(datum['Main Material'] || ''), 'neon') >= 0 ? 'Paint' : indexof(lower(datum['Main Material'] || ''), 'fibreglass') >= 0 || indexof(lower(datum['Main Material'] || ''), 'epoxy resin') >= 0 ? 'Other materials' : 'Not recorded'",
          "as": "material_group"
        },
        {
          "joinaggregate": [
           { "op": "count", "as": "location_count" }
          ],
          "groupby": [
            "Longitude",
            "Latitude"
          ]
        },
        {
          "window": [
            { "op": "row_number", "as": "location_rank" }
          ],
          "groupby": [
            "Longitude",
            "Latitude"
          
          ],
          "sort": [
            { "field": "Index", "order": "ascending" }
          ]
        },
        {
          "calculate": "datum.location_count > 1 ? toNumber(datum.Longitude) + 0.002 * cos(6.28318530718 * (datum.location_rank - 1) / datum.location_count) : toNumber(datum.Longitude)",
          "as": "display_longitude"
        },
        {
          "calculate": "datum.location_count > 1 ? toNumber(datum.Latitude) + 0.002 * sin(6.28318530718 * (datum.location_rank - 1) / datum.location_count) : toNumber(datum.Latitude)",
          "as": "display_latitude"
        }
      ],
      "mark": {
        "type": "circle",
        "stroke": "#ffffff",
        "strokeWidth": 0.55
      },
      "encoding": {
        "longitude": {
          "field": "display_longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "display_latitude",
          "type": "quantitative"
        },
        "size": {
          "value": 55
        },
        "color": {
          "field": "material_group",
          "type": "nominal",
          "title": "Material group",
          "scale": {
            "domain": [
              "Metal",
              "Stone / concrete / brick",
              "Timber",
              "Paint",
              "Tile / ceramic",
              "Mixed materials",
              "Other materials",
              "Not recorded"
            ],
            "range": [
              "#0072B2",
              "#8C8C8C",
              "#A65628",
              "#D55E00",
              "#56B4E9",
              "#CC79A7",
              "#E69F00",
              "#D3D3D3"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 4,
            "symbolSize": 95
          }
        },
        "opacity": {
          "condition": {
            "param": "materialSelection",
            "value": 0.9
          },
          "value": 0.13
        },
        "tooltip": [
          { "field": "Title", "type": "nominal", "title": "Artwork" },
          { "field": "Artist", "type": "nominal", "title": "Artist" },
          { "field": "Suburb", "type": "nominal", "title": "Suburb" },
          { "field": "Installed", "type": "nominal", "title": "Installed" },
          { "field": "Main Material", "type": "nominal", "title": "Recorded material" },
          { "field": "location_count", "type": "quantitative", "title": "Artworks at this recorded location" },
          { "field": "Description", "type": "nominal", "title": "Description" }
        ]
      }
    }
  ],
  "config": {
    "background": "#fffdf9",
    "view": {
      "stroke": null
    },
    "legend": {
      "labelFont": "Arial",
      "labelFontSize": 11,
      "titleFont": "Arial",
      "titleFontSize": 12
    }
  }
}
