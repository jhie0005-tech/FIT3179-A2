{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Three-city small-multiple point map of public art, coloured by a shared category crosswalk. Panels are the same pixel size, with explicit projection translate; each is framed to its own city (see subtitles for the ground width) with a scale bar.",
  "data": {
    "url": "Data/processed/public_art_comparison.csv",
    "format": {
      "type": "csv",
      "parse": {
        "longitude": "number",
        "latitude": "number",
        "installed_year": "number"
      }
    }
  },
  "hconcat": [
    {
      "title": {
        "text": "Brisbane",
        "subtitle": "198 works \u00b7 map window about 26 \u00d7 34 km",
        "anchor": "start",
        "subtitleColor": "#666"
      },
      "width": 260,
      "height": 340,
      "projection": {
        "type": "mercator",
        "center": [
          153.0577,
          -27.4547
        ],
        "scale": 56500,
        "translate": [
          130.0,
          170.0
        ]
      },
      "layer": [
        {
          "data": {
            "url": "Data/brisbane-suburbs.geojson",
            "format": {
              "type": "json",
              "property": "features"
            }
          },
          "mark": {
            "type": "geoshape",
            "fill": "#fbfaf6",
            "stroke": "#d6d0c2",
            "strokeWidth": 0.6
          }
        },
        {
          "transform": [
            {
              "filter": "datum.city === 'Brisbane'"
            },
            {
              "calculate": "datum.shared_category === 'Other / unclassified' ? 0 : 1",
              "as": "draw_order"
            },
            {
              "calculate": "datum.source_category ? datum.source_category : 'Not recorded in source'",
              "as": "src"
            },
            {
              "calculate": "datum.material ? datum.material : 'Not recorded'",
              "as": "mat"
            },
            {
              "calculate": "isValid(datum.installed_year) ? format(datum.installed_year, 'd') : 'Not recorded'",
              "as": "yr"
            }
          ],
          "mark": {
            "type": "circle",
            "size": 22,
            "opacity": 0.85,
            "stroke": "#ffffff",
            "strokeWidth": 0.3
          },
          "encoding": {
            "longitude": {
              "field": "longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "latitude",
              "type": "quantitative"
            },
            "order": {
              "field": "draw_order",
              "type": "quantitative"
            },
            "color": {
              "field": "shared_category",
              "type": "nominal",
              "title": "Shared category",
              "scale": {
                "domain": [
                  "Sculpture / object",
                  "Mural / wall art",
                  "Monument / memorial",
                  "Fountain / water feature",
                  "Functional public art",
                  "Other / unclassified"
                ],
                "range": [
                  "#1B9E77",
                  "#7570B3",
                  "#E7298A",
                  "#66A61E",
                  "#E6AB02",
                  "#666666"
                ]
              },
              "legend": {
                "orient": "bottom",
                "columns": 3,
                "symbolType": "circle",
                "labelLimit": 220,
                "titleAnchor": "start"
              }
            },
            "tooltip": [
              {
                "field": "shared_category",
                "type": "nominal",
                "title": "Shared category"
              },
              {
                "field": "src",
                "type": "nominal",
                "title": "Original source category"
              },
              {
                "field": "mat",
                "type": "nominal",
                "title": "Material"
              },
              {
                "field": "yr",
                "type": "nominal",
                "title": "Installed"
              }
            ]
          }
        },
        {
          "data": {
            "values": [
              {
                "lon1": 152.9362,
                "lon2": 152.9868,
                "lat": -27.5968
              }
            ]
          },
          "mark": {
            "type": "rule",
            "color": "#333",
            "strokeWidth": 2
          },
          "encoding": {
            "longitude": {
              "field": "lon1",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "longitude2": {
              "field": "lon2"
            },
            "latitude2": {
              "field": "lat"
            }
          }
        },
        {
          "data": {
            "values": [
              {
                "lon": 152.9615,
                "lat": -27.5968,
                "label": "5 km"
              }
            ]
          },
          "mark": {
            "type": "text",
            "dy": -7,
            "fontSize": 11,
            "color": "#333",
            "stroke": "#f4f1ea",
            "strokeWidth": 3,
            "strokeJoin": "round"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "label"
            }
          }
        }
      ]
    },
