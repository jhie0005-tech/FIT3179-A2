{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "A locator map of galleries in the supplied Australian gallery dataset.",
  "width": 720,
  "height": 580,
  "projection": {
    "type": "mercator",
    "center": [134, -27],
    "scale": 890
  },
  "layer": [
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/world-atlas@2/countries-50m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#ece7df",
        "stroke": "#9c9387",
        "strokeWidth": 0.8
      }
    },
    {
  "data": {
    "url": "../Data/australia-states.geojson",
    "format": {"type": "json", "property": "features"}
  },
  "mark": {
    "type": "geoshape",
    "fill": null,
    "stroke": "#b8aea0",
    "strokeWidth": 0.6,
    "strokeDash": [3, 2]
  }
  },
  {
  "data": {
    "values": [
      {"city": "Sydney",     "lon": 151.2093, "lat": -33.8688},
      {"city": "Melbourne",  "lon": 144.9631, "lat": -37.8136},
      {"city": "Brisbane",   "lon": 153.0251, "lat": -27.4698},
      {"city": "Perth",      "lon": 115.8605, "lat": -31.9505},
      {"city": "Adelaide",   "lon": 138.6007, "lat": -34.9285},
      {"city": "Hobart",     "lon": 147.3272, "lat": -42.8821},
      {"city": "Darwin",     "lon": 130.8456, "lat": -12.4634},
      {"city": "Canberra",   "lon": 149.1300, "lat": -35.2809},
      {"city": "Alice Springs", "lon": 133.8807, "lat": -23.6980}
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "point",
        "shape": "diamond",
        "size": 45,
        "filled": true,
        "color": "#2b2b2b"
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"}
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 7,
        "dy": -2,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#000000",
        "stroke": "#2b2b2b",
        "strokeWidth": 1.5,
        "paintOrder": "stroke"
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "city", "type": "nominal"}
      }
    }
  ]
  },
    {
      "data": {
        "url": "Data\\processed\\galleries_clean.csv"
      },
      "transform": [
        {
          "filter": "isValid(datum.longitude) && isValid(datum.latitude)"
        }
      ],
      "mark": {
        "type": "circle",
        "filled": true,
        "color": "#9e3d2e",
        "opacity": 0.72,
        "stroke": "#fffdf9",
        "strokeWidth": 0.4
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "value": 34
        },
        "tooltip": [
          { "field": "Gallery", "type": "nominal", "title": "Gallery" },
          { "field": "Address", "type": "nominal", "title": "Address" }
        ]
      }
    }
    

  ],
  "config": {
    "background": "#fffdf9",
    "view": {
      "stroke": null
    }
  }
}
